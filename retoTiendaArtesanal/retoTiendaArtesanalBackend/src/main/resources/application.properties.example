spring.application.name=retotiendaartesanal-backend
server.port=8080

spring.datasource.url=jdbc:mysql://localhost:3307/retotiendaartesanal
spring.datasource.username=reto_user
spring.datasource.password=TU_PASSWORD_MYSQL

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

stripe.secret-key=TU_STRIPE_SECRET_KEY
stripe.webhook-secret=TU_STRIPE_WEBHOOK_SECRET
app.frontend-url=http://localhost:5173

jwt.secret=TU_JWT_SECRET
jwt.expiration=86400000

spring.mail.host=localhost
spring.mail.port=1025
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false
mail.from=pedidos@hiloybarro.com